# --- Database & dashboard sessions -----------------------------------------
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Must be at least 32 characters. Also derives the key that encrypts the MCP
# access token inside the dashboard session cookie, so rotating it signs
# everyone out.
DASHBOARD_SESSION_SECRET=use-the-same-long-random-secret-as-the-mcp-server

# Public origin used to build the OAuth redirect URI and client id.
# Defaults to https://www.copilotai.live; set it for preview deployments.
# DASHBOARD_ORIGIN=https://www.copilotai.live

# --- Owner console ----------------------------------------------------------
# Separate owner-console credentials. The password hash must use the documented
# scrypt$<salt>$<hash> format; never store a plaintext owner password.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=scrypt$base64url-salt$base64url-hash
OWNER_SESSION_SECRET=use-a-different-long-random-secret-for-owner-sessions

# --- LLM gateway ------------------------------------------------------------
# Server-side CometAPI configuration. Never expose this key in browser code.
COMET_API_KEY=your-cometapi-key
FAST_MODEL=gemini-2.5-flash-lite
DEFAULT_MODEL=gemini-2.5-flash
ADVANCED_MODEL=deepseek-v3.2
PREMIUM_MODEL=kimi-k2.5

# --- Email reports (Resend) -------------------------------------------------
# Without RESEND_API_KEY the report endpoint returns a "simulated" response and
# sends nothing. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Money Copilot <reports@contact.copilotai.live>

# --- Optional profile enrichment -------------------------------------------
# MCPize's public read-only anon key, used solely to resolve the signed-in
# user's display name and avatar. Profile enrichment is skipped when unset.
MCPIZE_ANON_KEY=
