{
  "rewrites": [
    { "source": "/", "destination": "/site/index.html" },
    { "source": "/dashboard", "destination": "/site/dashboard/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/site/dashboard/$1" },
    { "source": "/owner", "destination": "/site/owner/login.html" },
    { "source": "/owner/login", "destination": "/site/owner/login.html" },
    { "source": "/owner/monitor", "destination": "/site/owner/monitor.html" },
    { "source": "/owner/(.*)", "destination": "/site/owner/$1" },
    { "source": "/authorize", "destination": "/api/dashboard-authorize" },
    { "source": "/privacy", "destination": "/site/privacy.html" },
    { "source": "/terms", "destination": "/site/terms.html" },
    { "source": "/support", "destination": "/site/support.html" },
    { "source": "/robots.txt", "destination": "/site/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/site/sitemap.xml" },
    { "source": "/assets/(.*)", "destination": "/site/assets/$1" }
  ],
  "redirects": [
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/support.html", "destination": "/support", "permanent": true }
  ]
}
